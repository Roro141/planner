# Copy this file to .env.local and fill in your own values from the Supabase
# dashboard: Project Settings → API (or the "Connect" button).
#
# Both values are safe to ship to the browser: the publishable/anon key only
# allows what the row-level security policies in supabase/schema.sql allow.
# Never put the service_role / secret key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
