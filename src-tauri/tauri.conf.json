{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Planner Widget",
  "version": "0.1.0",
  "identifier": "com.roro141.planner.widget",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173/widget.html",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "widget",
        "title": "Planner",
        "url": "widget.html",
        "width": 64,
        "height": 64,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "maximizable": false,
        "minimizable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "shortDescription": "Today's tasks in a bubble on your desktop"
  }
}
